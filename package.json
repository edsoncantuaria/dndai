{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 9002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --test --import tsx \"src/__tests__/**/*.spec.ts\"",
    "copy-dice-assets": "node ./copy-dice-assets.js",
    "postinstall": "npm run copy-dice-assets",
    "dev:backend": "cd backend && npm run dev",
    "install:backend": "cd backend && npm install",
    "seedRegion": "npm run seed:regions --prefix backend",
    "seed:regions": "npm run seed:regions --prefix backend",
    "srd:up": "docker compose -f docker-compose.srd.yml up -d --build",
    "srd:down": "docker compose -f docker-compose.srd.yml down",
    "dev:infra": "sh scripts/dev-infra.sh",
    "dev:local": "sh scripts/dev-local.sh",
    "dev:docker": "docker compose -f docker-compose.penai.yml -f docker-compose.dev.yml --profile penai --profile dev up",
    "compose:infra": "docker compose up -d mysql redis srd-db srd-cache srd-api minio piper qdrant",
    "compose:down": "docker compose down",
    "compose:app": "echo '⚠️  Modo PRODUÇÃO (sem hot reload). Dev diário: npm run dev:local' && docker compose --profile full up -d --build",
    "compose:cloudive": "docker compose -f docker-compose.yml -f docker-compose.cloudive.yml --profile full up -d --build",
    "deploy:cloudive": "sh scripts/deploy-cloudive.sh",
    "docker:up": "echo '⚠️  Modo PRODUÇÃO (sem hot reload). Dev diário: npm run dev:local' && docker compose --profile full up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "test": "npm run test --prefix backend",
    "test:backend": "npm run test --prefix backend",
    "verify:srd": "node scripts/verify-srd-snapshot.js",
    "sync:srd": "node scripts/sync-srd-api.js",
    "sync:dnd5eapi": "node scripts/sync-dnd5eapi.js"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@genkit-ai/google-genai": "^1.21.0",
    "@google/generative-ai": "^0.15.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "data-urls": "^6.0.0",
    "framer-motion": "^11.3.19",
    "genkit": "^1.21.0",
    "lucide-react": "^0.408.0",
    "next": "15.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "wav": "^1.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@types/data-urls": "^3.0.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.3",
    "fs-extra": "^11.2.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
