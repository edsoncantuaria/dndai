{
  "name": "cda-backend-refactor",
  "version": "1.0.0",
  "description": "Novo backend para Crônicas de Aventuras com sessões de IA isoladas.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:log": "tsx watch src/server.ts 2>&1 | tee logs/server_$(date +'%Y-%m-%d_%H-%M-%S').log",
    "seed:data": "tsx src/scripts/migrate-data.ts"
  },
  "keywords": [
    "rpg",
    "ai",
    "genkit",
    "nodejs",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@genkit-ai/google-genai": "^1.21.0",
    "@genkit-ai/googleai": "^1.21.0",
    "@google/generative-ai": "^0.15.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "genkit": "^1.21.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.0",
    "mysql2": "^3.10.3",
    "redis": "^4.6.15",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/minio": "^7.1.1",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
