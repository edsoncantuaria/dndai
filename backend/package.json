{
  "name": "cda-backend-refactor",
  "version": "1.0.0",
  "description": "Novo backend para Crônicas de Aventuras com sessões de IA isoladas.",
  "main": "dist/penaiServer.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/penaiServer.js",
    "dev": "tsx watch src/penaiServer.ts",
    "dev:penai": "tsx watch src/penaiServer.ts",
    "dev:log": "tsx watch src/penaiServer.ts 2>&1 | tee logs/server_$(date +'%Y-%m-%d_%H-%M-%S').log",
    "penai:smoke": "tsx src/scripts/penaiSmoke.ts",
    "penai:smoke:srd-ptbr": "tsx src/scripts/penaiSrdPtBrOpsSmoke.ts",
    "penai:smoke:byok": "tsx src/scripts/penaiByokSmoke.ts",
    "temporal:smoke": "tsx src/scripts/temporalSmoke.ts",
    "worker:temporal": "tsx src/temporalWorkerMain.ts",
    "seed:data": "tsx src/scripts/migrate-data.ts",
    "seed:all": "npm run penai:seed:srd-ptbr && npm run seed:regions && npm run seed:enemy-templates && npm run ai:seed-normalizations",
    "test": "REDIS_URL=mock node --test --import tsx \"src/__tests__/penai*.spec.ts\" \"src/__tests__/penaiMotorGameplay.spec.ts\" \"src/__tests__/npcPersonality.spec.ts\"",
    "test:all": "REDIS_URL=mock node --test --import tsx \"src/__tests__/**/*.spec.ts\"",
    "migration:run": "tsx src/database/run-migrations.ts",
    "penai:migration:run": "tsx src/GameMaster/database/run-penai-migrations.ts",
    "penai:seed:srd-ptbr": "tsx src/GameMaster/database/seed/seedSrdPtBrHomebrew.ts",
    "penai:import:foundry-overrides": "tsx src/GameMaster/database/seed/importFoundrySrdPtBrOverrides.ts",
    "penai:import:foundry-bundle": "tsx src/GameMaster/database/seed/importFoundrySrdPtBrBundle.ts",
    "penai:extract:phb-overrides": "tsx src/GameMaster/database/seed/extractPhbPtBrOverrides.ts",
    "penai:validate:phb-overrides": "tsx src/GameMaster/database/seed/validatePhbPtBrOverrides.ts",
    "penai:migrate:homebrew-mysql": "tsx src/scripts/migrate-homebrew-mysql-to-penai.ts",
    "ai:integrity-check": "tsx src/scripts/aiIntegrityCheck.ts",
    "ai:test-structured": "mkdir -p .tmp && TMPDIR=./.tmp tsx src/scripts/testStructuredOutput.ts",
    "ai:compare-structured": "mkdir -p .tmp && TMPDIR=./.tmp tsx src/scripts/compareStructuredScenario.ts",
    "ai:openrouter-benchmark": "mkdir -p logs && tsx src/scripts/openRouterBenchmark.ts",
    "ai:oss-metrics": "tsx src/scripts/ossMetrics.ts",
    "ai:oss-smoke": "tsx src/scripts/ossPipelineSmoke.ts",
    "ai:oss-benchmark": "tsx src/scripts/ossQualityBenchmark.ts",
    "ai:oss-embedding-smoke": "tsx src/scripts/ossEmbeddingSmoke.ts",
    "ai:oss-vector-smoke": "tsx src/scripts/ossVectorMemorySmoke.ts",
    "ai:gemini-smoke": "tsx src/scripts/geminiPipelineSmoke.ts",
    "ai:gemini-embedding-smoke": "tsx src/scripts/geminiEmbeddingSmoke.ts",
    "ai:gemini-mesa-benchmark": "tsx src/scripts/geminiMesaBenchmark.ts",
    "ai:qdrant-benchmark": "tsx src/scripts/qdrantBenchmark.ts",
    "ai:oss-apply-temp-profile": "tsx src/scripts/ossApplyTemperatureProfile.ts",
    "ai:test-structured2": "mkdir -p .tmp && TMPDIR=./.tmp tsx src/scripts/testStructured2.ts | tee logs/TESTE-STRUTRADO_$(date +'%Y-%m-%d_%H-%M-%S').log",
    "ai:test-structured3": "mkdir -p .tmp && TMPDIR=./.tmp tsx src/scripts/testStructured3.ts | tee logs/TESTE-STRUTRADO3_$(date +'%Y-%m-%d_%H-%M-%S').log",
    "ai:test-structured4": "mkdir -p .tmp && TMPDIR=./.tmp tsx src/scripts/testStructured4.ts | tee logs/TESTE-STRUTRADO4_$(date +'%Y-%m-%d_%H-%M-%S').log",
    "ai:test-structured5": "mkdir -p .tmp && TMPDIR=./.tmp tsx src/scripts/testStructured5.ts",
    "ai:test-structured-full": "mkdir -p .tmp && TMPDIR=./.tmp tsx src/scripts/testStructuredFull.ts",
    "ai:seed-normalizations": "tsx src/scripts/seedNormalizationPatterns.ts",
    "seed:regions": "tsx src/scripts/seedRegions.ts",
    "seed:enemy-templates": "tsx src/scripts/seedEnemyTemplates.ts",
    "srd:import": "tsx src/scripts/importSrdResources.ts",
    "apply-delta": "node scripts/applyTestDelta.js",
    "apply-resource": "node scripts/applyResourceDelta.js",
    "apply-entity": "node scripts/applyEntityDelta.js",
    "test-rest-action": "node scripts/testRestAction.js",
    "test-state-version": "node scripts/testStateVersion.js",
    "clean-roll": "node scripts/clearRolls.js",
    "test-state-hints": "node scripts/testStateHints.mjs",
    "check-session-logs": "node scripts/checkSessionLogs.js",
    "scenario-attack": "node scripts/runAttackScenario.js",
    "scenario:intent": "node scripts/runIntentScenario.js",
    "test-session-reuse": "node scripts/testSessionReuse.js",
    "session:smoke": "tsx src/scripts/sessionSimulator.ts",
    "chaos:smoke": "tsx src/scripts/chaosPipelineSmoke.ts"
  },
  "keywords": [
    "rpg",
    "ai",
    "genkit",
    "nodejs",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/websocket": "^11.2.0",
    "@genkit-ai/express": "^1.21.0",
    "@genkit-ai/google-genai": "^1.21.0",
    "@genkit-ai/googleai": "^1.21.0",
    "@google/genai": "^1.29.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "@temporalio/activity": "^1.17.2",
    "@temporalio/client": "^1.17.2",
    "@temporalio/worker": "^1.17.2",
    "@temporalio/workflow": "^1.17.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fastify": "^5.8.5",
    "genkit": "^1.21.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.0",
    "mysql2": "^3.10.3",
    "pg": "^8.21.0",
    "redis": "^4.6.15",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/minio": "^7.1.1",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
