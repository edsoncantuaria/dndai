  "logEntries": [
    {
      "type": "narration",
      "content": "Você desperta em uma vasta biblioteca arcana, o ar pesado com o cheiro de pergaminhos antigos e poeira."
    },
    {
      "type": "player",
      "content": "Observo o salão e procuro pistas do próximo desafio."
    },
    {
      "type": "narration",
      "content": "Seus olhos percorrem o vasto salão. Estantes imponentes repletas de incontáveis tomos se estendem até um teto abobadado, iluminado por feixes de luz solar que filtram por janelas arqueadas. No centro, um grande e ornamentado pedestal sustenta um único pergaminho solto, que brilha fracamente com uma luz interior. Em uma mesa próxima, uma refeição pela metade e uma pena descartada sugerem atividade recente."
    }
  ],
  "actionOptions": [
    {
      "text": "Aproximar-se do pedestal e examinar o pergaminho brilhante.",
      "action": "examine",
      "skill": "Investigation"
    },
    {
      "text": "Investigar a mesa próxima, a refeição e a pena.",
      "action": "investigate",
      "skill": "Investigation"
    },
    {
      "text": "Começar a procurar por livros específicos ou passagens secretas nas estantes.",
      "action": "search",
      "skill": "Perception"
    }
  ],
