FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_API_URL=http://localhost:8071/api
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8071/
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
RUN npm run build
EXPOSE 9002
CMD ["npm", "run", "start", "--", "-p", "9002", "-H", "0.0.0.0"]
