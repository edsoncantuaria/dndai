{
  "name": "cda-backend-refactor",
  "version": "1.0.0",
  "description": "Backend PENAI — Crônicas de Aventuras (Fastify + Postgres + Temporal).",
  "main": "dist/src/penaiServer.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/penaiServer.js",
    "dev": "tsx watch src/penaiServer.ts",
    "dev:penai": "tsx watch src/penaiServer.ts",
    "dev:log": "tsx watch src/penaiServer.ts 2>&1 | tee logs/server_$(date +'%Y-%m-%d_%H-%M-%S').log",
    "penai:smoke": "tsx src/scripts/penaiSmoke.ts",
    "penai:smoke:srd-ptbr": "tsx src/scripts/penaiSrdPtBrOpsSmoke.ts",
    "penai:smoke:byok": "tsx src/scripts/penaiByokSmoke.ts",
    "temporal:smoke": "tsx src/scripts/temporalSmoke.ts",
    "worker:temporal": "tsx src/temporalWorkerMain.ts",
    "test": "REDIS_URL=mock node --test --import tsx \"src/__tests__/penai*.spec.ts\" \"src/__tests__/penaiMotorGameplay.spec.ts\" \"src/__tests__/npcPersonality.spec.ts\" \"src/__tests__/successMetrics.spec.ts\" \"src/__tests__/motorGuards.spec.ts\"",
    "test:all": "REDIS_URL=mock node --test --import tsx \"src/__tests__/**/*.spec.ts\"",
    "penai:migration:run": "tsx src/GameMaster/database/run-penai-migrations.ts",
    "penai:db:prepare": "npm run penai:migration:run && npm run seed:penai-world",
    "penai:replay-projectors": "tsx src/scripts/replaySessionProjectors.ts",
    "penai:seed:canon-npcs": "tsx src/scripts/seedCanonicalRegionNpcs.ts",
    "penai:seed:canon-npcs:server": "tsx src/scripts/seedCanonicalRegionNpcs.ts -- --all --count 20",
    "penai:seed:auto-npcs": "tsx src/scripts/importAutoCanonNpcMock.ts",
    "penai:build:auto-npc-mock": "tsx src/scripts/writeAutoCanonNpcMockJson.ts",
    "penai:seed:srd-ptbr": "tsx src/GameMaster/database/seed/seedSrdPtBrHomebrew.ts",
    "penai:import:foundry-overrides": "tsx src/GameMaster/database/seed/importFoundrySrdPtBrOverrides.ts",
    "penai:import:foundry-bundle": "tsx src/GameMaster/database/seed/importFoundrySrdPtBrBundle.ts",
    "penai:extract:phb-overrides": "tsx src/GameMaster/database/seed/extractPhbPtBrOverrides.ts",
    "penai:validate:phb-overrides": "tsx src/GameMaster/database/seed/validatePhbPtBrOverrides.ts",
    "seed:penai-world": "tsx src/scripts/seedPenaiWorld.ts",
    "seed:penai-license": "tsx src/scripts/seedPenaiLicenseKey.ts",
    "map:generate-aurathis": "tsx scripts/generateAurathisMapSvg.ts",
    "map:calibrate-pois": "tsx scripts/calibrateAurathisMapPois.ts",
    "session:smoke": "tsx src/scripts/sessionSimulator.ts"
  },
  "keywords": [
    "rpg",
    "penai",
    "fastify",
    "temporal"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/websocket": "^11.2.0",
    "@google/genai": "^1.29.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "@temporalio/activity": "^1.17.2",
    "@temporalio/client": "^1.17.2",
    "@temporalio/worker": "^1.17.2",
    "@temporalio/workflow": "^1.17.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "http-errors": "^2.0.0",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.0",
    "pg": "^8.21.0",
    "redis": "^4.6.15",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/minio": "^7.1.1",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
